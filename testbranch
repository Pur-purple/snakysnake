#new functions

def drawshape(x, y, rot, shape, color, size):
    drawer.goto(x, y)
    drawer.tiltangle(rot)
    drawer.shape(shape)
    drawer.color(color)
    drawer.shapesize(size)
    drawer.stamp()

#math
def normalize(vector):
    vector.X = vector.X / vector.magnitude
    vector.Y = vector.Y / vector.magnitude

def lerp(a, b, t):
    return a + (b - a) * t

